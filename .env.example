# HTTP port.
PORT=3004

# Comma-separated browser origin allowlist.
# If unset, localhost origins are allowed for local development.
TABULA_JSON_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage driver. Use file for local development and gcs for production.
TABULA_JSON_STORAGE_DRIVER=file

# Local encrypted JSON share storage directory.
TABULA_JSON_DATA_DIR=.tabula-json/data

# Google Cloud Storage production bucket and optional object prefix.
# Required when TABULA_JSON_STORAGE_DRIVER=gcs.
TABULA_JSON_GCS_BUCKET=tabula-json-prod
TABULA_JSON_GCS_PREFIX=json/

# Maximum HTTP JSON body bytes.
TABULA_JSON_MAX_PAYLOAD_BYTES=1048576
