{
  "name": "tabula-json",
  "version": "0.1.0",
  "description": "Encrypted snapshot storage service for Tabula.md share links.",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:worker": "wrangler dev",
    "dev:watch": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "smoke:production": "node scripts/smoke-production.mjs",
    "typegen": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260628.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.105.0"
  }
}
