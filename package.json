{
  "name": "tabula-json",
  "version": "0.1.0",
  "description": "Encrypted snapshot storage for Tabula.md Export links.",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:watch": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "deploy": "npm run build && node scripts/write-app-yaml.mjs && node scripts/deploy-gcp.mjs",
    "deploy:gcp": "npm run deploy",
    "cleanup:expired": "npm run build && node scripts/cleanup-expired.mjs",
    "surface:check": "node scripts/public-surface-check.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "test": "vitest run && npm run surface:check",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  }
}
